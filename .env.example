# Server: localhost first. LAN mode requires password and HTTPS certificates.
HOST=127.0.0.1
PORT=8787
JARVIS_ACCESS_PASSWORD=
HTTPS_KEY=
HTTPS_CERT=

# Gemini: server-side API key only. Choose model IDs available to your account.
GEMINI_API_KEY=
JARVIS_GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
JARVIS_GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
JARVIS_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
JARVIS_GEMINI_LIVE_MODEL=gemini-3.8-live

# Local tasks only: authenticated Codex CLI on this host.
JARVIS_ENGINE=hybrid
CODEX_BIN=codex
JARVIS_CORE_MODEL=gpt-6-luna
JARVIS_CORE_REASONING=low
JARVIS_TIMEZONE=UTC
JARVIS_IMPORT_CODEX_SESSIONS=false

# Optional Home Assistant (never put these in browser code).
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_HOME_ZONE=zone.home
HA_WORK_ZONE_MEMBER1=
HA_WORK_ZONE_MEMBER2=

# Optional public integrations.
GOOGLE_MAPS_BROWSER_KEY=
YOUTUBE_API_KEY=

# Optional Qdrant embedding service.
QDRANT_URL=http://127.0.0.1:6333
JARVIS_SEMANTIC_URL=http://127.0.0.1:6335
QDRANT__SERVICE__API_KEY=

# Optional official Cloud Billing export. These are identifiers, not API keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_BILLING_ACCOUNT=
GOOGLE_BILLING_DATASET=jarvis_billing
