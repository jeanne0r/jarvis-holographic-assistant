[Unit]
Description=Jarvis on-demand synthetic mission supervisor
After=network-online.target jarvis-hermes-private-boot.service
Requires=jarvis-hermes-private-boot.service
Wants=network-online.target
[Service]
Type=simple
User=jarvis-hermes-supervisor
Group=jarvis-hermes-supervisor
WorkingDirectory=/opt/jarvis-hermes-supervisor
# Root loads the per-UID egress table at every start (idempotent replace), then
# the unprivileged self-test proves allowed AND forbidden paths before ExecStart.
ExecStartPre=+/usr/sbin/nft -f /etc/jarvis-hermes-supervisor/egress.nft
ExecStartPre=/usr/bin/python3 -B -m scripts.egress_selftest --policy /etc/jarvis-hermes-supervisor/egress-policy.json --mode start
ExecStart=/usr/bin/python3 -B -m scripts.demand_supervisor --config /etc/jarvis-hermes-supervisor/config.json
Environment=HOME=/var/lib/jarvis-hermes-supervisor
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
StateDirectory=jarvis-hermes-supervisor
StateDirectoryMode=0700
ReadOnlyPaths=/etc/jarvis-hermes-supervisor /opt/jarvis-hermes-supervisor
# Existing lifecycle writes its evidence only under these dedicated bind mounts.
BindPaths=/var/lib/jarvis-hermes-supervisor/docs:/opt/jarvis-hermes-supervisor/docs
BindPaths=/var/lib/jarvis-hermes-supervisor/data:/opt/jarvis-hermes-supervisor/data
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET
# Single network layer: per-UID nftables (port-precise, see egress.nft).
# IPAddressAllow=127.0.0.0/8 would have allowed the local gateway (8788).
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8643
SocketBindAllow=ipv4:tcp:11435
# Preflight guard port, also the self-test witness port (never allowed by nft).
SocketBindAllow=ipv4:tcp:8792
MemoryMax=768M
CPUQuota=50%
TasksMax=64
KillMode=control-group
TimeoutStopSec=350
Restart=no
[Install]
WantedBy=multi-user.target
