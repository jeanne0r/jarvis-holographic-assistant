    "test:browser":"node verify-speech.cjs",
    "scan:public":"python3 scripts/scan-public.py",
    "memory:index":"node --env-file=.env scripts/index-memory.mjs"
  },
  "dependencies":{"ws":"8.18.3"},
  "devDependencies":{"playwright":"1.56.1"}
}
