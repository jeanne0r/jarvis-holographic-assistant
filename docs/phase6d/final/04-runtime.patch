+  args[-1:-1]=['-c','mcp_servers.jarvis.command="/usr/bin/node"','-c','mcp_servers.jarvis.args=["/runtime/tool-proxy.mjs"]','-c','mcp_servers.jarvis.required=true']
+ return prefix+['--']+args
